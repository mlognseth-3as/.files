# Init Zap
ZAP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zap"

if [[ ! -f "$ZAP_DIR/zap.zsh" ]]; then
  print "Installing Zap…"
  zsh <(
    curl -fsSL https://raw.githubusercontent.com/zap-zsh/zap/master/install.zsh
  ) --branch release-v1 --keep
fi

[[ -f "$ZAP_DIR/zap.zsh" ]] && source "$ZAP_DIR/zap.zsh"
unset ZAP_DIR

# Zap plugins
plug "zsh-users/zsh-autosuggestions"
plug "zap-zsh/supercharge"
plug "zsh-users/zsh-syntax-highlighting"

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=50000
setopt HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS SHARE_HISTORY

# Behaviour
setopt AUTO_CD EXTENDED_GLOB

# Aliases and machine-specific settings
[[ -f ~/.zsh_aliases ]] && source ~/.zsh_aliases
[[ -f ~/.zshrc.local ]] && source ~/.zshrc.local

# Alias expansion
expand-alias-space() {
  zle _expand_alias
  zle self-insert
}
zle -N expand-alias-space
bindkey ' ' expand-alias-space

# Completion
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}' 'r:|=*' 'm:{a-zA-Z}={A-Za-z} l:|=* r:|=*'

compdef k=kubectl 2>/dev/null
compdef kubecolor=kubectl 2>/dev/null

# Optional integrations
if [[ -f /opt/homebrew/opt/fzf/shell/key-bindings.zsh && -f /opt/homebrew/opt/fzf/shell/completion.zsh ]]; then
  source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
  source /opt/homebrew/opt/fzf/shell/completion.zsh
elif command -v fzf >/dev/null; then
  source <(fzf --zsh)
fi
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"
if command -v azenv >/dev/null; then
  azenv() {
    local init
    init="$(command azenv init zsh)" || return
    unfunction azenv
    eval "$init" || return
    azenv "$@"
  }
fi

export PATH=$PATH:~/.cargo/bin

# pnpm
export PNPM_HOME="/Users/mikael.lognseth/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME:"*) ;;
  *) export PATH="$PNPM_HOME:$PATH" ;;
esac
# pnpm end

# Prompt and contextual tool hints
if command -v oh-my-posh >/dev/null && [[ -f "$HOME/.config/oh-my-posh/zen.toml" ]]; then
  eval "$(oh-my-posh init zsh --config "$HOME/.config/oh-my-posh/zen.toml")"
  ZLE_RPROMPT_INDENT=1
fi
