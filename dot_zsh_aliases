fix-git() {
  local current repo
  current=$(git remote get-url origin 2>/dev/null)
  if [[ "$current" == *"github.com"* ]]; then
    repo=$(echo "$current" | sed 's|.*github.com[:/]\(.*\)\.git|\1|')
  else
    repo="3as-cloud/$(basename "$PWD")"
  fi
  git remote set-url origin "$(gh repo view "$repo" --json sshUrl -q .sshUrl)"
}

refresh-main() {
  local current
  current=$(git branch --show-current 2>/dev/null)

  if [[ -z "$current" ]]; then
    echo 'Not on a branch, or not inside a Git repository.' >&2
    return 1
  fi

  if [[ "$current" == 'main' ]]; then
    git pull --ff-only
    return $?
  fi

  git switch main && git pull --ff-only
  local rc=$?

  git switch "$current"
  return $rc
}
